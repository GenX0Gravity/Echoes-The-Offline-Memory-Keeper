# ============================================================
# ECHOES – The Offline Memory Keeper Environment Configuration
# ============================================================

# Application Port (local development)
PORT=3000

# Local Ollama Host URL
# Default local instance is http://127.0.0.1:11434
# For Vercel cloud deployments connecting to a local machine,
# use a secure tunnel URL (e.g. https://<subdomain>.trycloudflare.com or https://<id>.ngrok-free.app)
OLLAMA_HOST=http://127.0.0.1:11434

# Default Open-Source Model Identifier
# Default recommended model: qwen2.5:3b (fast, expressive, ~2.5GB RAM)
# Alternative models: qwen2.5:7b, llama3.2, mistral, gemma2:2b
OLLAMA_MODEL=qwen2.5:3b

# Note: Echoes requires ZERO closed-source or paid API keys.
# No OpenAI, Anthropic, or external cloud tokens needed.

